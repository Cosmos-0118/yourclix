{
  "name": "@yourclix/your",
  "version": "0.1.0",
  "description": "Developer-first macOS optimizer CLI",
  "type": "module",
  "bin": {
    "your": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh",
    "prepare": "npm run build"
  },
  "keywords": [
    "macos",
    "optimizer",
    "developer-tools",
    "cleanup",
    "cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
